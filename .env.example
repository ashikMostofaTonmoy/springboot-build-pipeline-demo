# Copy to .env and fill in. .env is gitignored.

# docker-compose.yml (app)
DOCKER_IMAGE=ashikmostofatonmoy/springboot-demo:latest

# docker-compose.tools.yml
TUNNEL_TOKEN=                # Cloudflare tunnel token (Zero Trust > Tunnels > your tunnel)
DTRACK_API_URL=http://localhost:8082   # public API hostname when tunneled, e.g. https://dtrackapi.example.com

# Local SonarQube analysis (mvn sonar:sonar)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
